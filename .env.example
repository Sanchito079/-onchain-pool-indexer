# On-Chain Pool Indexer — environment variables
# Copy to .env and fill in your values.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55422/postgres?sslmode=disable

# ── Solana ────────────────────────────────────────────────────────────────────
# HTTP RPC — used for getProgramAccounts backfill + mint decimals
SOLANA_RPC_ENDPOINT=https://api.mainnet-beta.solana.com
# WS RPC — used for logsSubscribe live pool creation events
# If omitted, auto-derived from SOLANA_RPC_ENDPOINT (https→wss)
SOLANA_WS_ENDPOINT=wss://api.mainnet-beta.solana.com

# ── BSC ───────────────────────────────────────────────────────────────────────
# Also accepts RPC_ENDPOINT_BSC (price-fetcher compatible name)
BSC_RPC_ENDPOINT=https://bsc-dataseed.nariox.org/
# WS — if omitted, auto-derived from BSC_RPC_ENDPOINT
# BSC_WS_ENDPOINT=wss://...

# ── Base ──────────────────────────────────────────────────────────────────────
# Also accepts RPC_ENDPOINT_BASE
BASE_RPC_ENDPOINT=https://mainnet.base.org/
# WS — if omitted, auto-derived from BASE_RPC_ENDPOINT
# BASE_WS_ENDPOINT=wss://...
